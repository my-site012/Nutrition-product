<section class="goal-section" id="goal-section">
  <div class="section-title">
    <span class="section-subtitle">PERSONALISED RESULTS</span>
    <h2>Shop By <span>Your Goal</span></h2>
    <p>Target your nutrition to match your exact athletic objectives</p>
  </div>

  <div class="goal-tabs">
    <button class="goal-tab active" data-goal="muscle-building"><i class="fas fa-dumbbell"></i> Lean Muscle</button>
    <button class="goal-tab" data-goal="weight-loss"><i class="fas fa-fire"></i> Weight Loss &amp; Shred</button>
    <button class="goal-tab" data-goal="energy"><i class="fas fa-bolt"></i> Energy &amp; Focus</button>
    <button class="goal-tab" data-goal="recovery"><i class="fas fa-heart-pulse"></i> Muscle Recovery</button>
    <button class="goal-tab" data-goal="gain-mass"><i class="fas fa-arrow-trend-up"></i> Mass &amp; Size</button>
  </div>

  {%- comment -%} Tab 1: Muscle Building (Active by default) {%- endcomment -%}
  <div class="product-grid goal-products" data-goal="muscle-building" style="display:grid;">
    {%- assign ml_col = collections['lean-muscle'] -%}
    {%- if ml_col != blank and ml_col.products.size > 0 -%}
