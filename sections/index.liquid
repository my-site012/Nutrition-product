{%- comment -%} Hero Banner Section {%- endcomment -%}
<section class="hero-section" id="hero">
  <div class="hero-bg">
    {%- if section.settings.hero_image != blank -%}
      <img
        class="hero-bg-image"
        src="{{ section.settings.hero_image | image_url: width: 1920 }}"
        alt="{{ section.settings.hero_heading | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <img
        class="hero-bg-image"
        src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=1920&auto=format&fit=crop"
        alt="NSNZ Nutrition Performance"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
    <div class="hero-overlay"></div>
  </div>
  <div class="hero-content">
    <div class="hero-eyebrow">
      <i class="fas fa-bolt"></i> {{ section.settings.hero_eyebrow | default: "New Zealand's #1 Destination For Sports Nutrition" }}
    </div>
    <h1 class="hero-title">
      {{ section.settings.hero_heading | default: 'Fuel Your <span>Performance</span>' }}
    </h1>
    <p class="hero-desc">{{ section.settings.hero_desc | default: 'Official NZ distributor for Ghost, Ryse, RAW CBUM, C4 Cellucor & more. Same-day dispatch across New Zealand on orders before 3:45pm.' }}</p>
    <div class="hero-cta">
      <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="btn-primary">
        <i class="fas fa-shopping-bag"></i>
        {{ section.settings.btn1_text | default: 'Shop All Supplements' }}
      </a>
      <a href="{{ section.settings.btn2_url | default: '/collections/top-50' }}" class="btn-outline">
        <i class="fas fa-trophy"></i>
        {{ section.settings.btn2_text | default: 'Top 50 Bestsellers' }}
      </a>
    </div>
    <div class="hero-badges">
      <div class="hero-badge-pill"><i class="fas fa-truck-fast"></i> Free NZ Shipping $60+</div>
      <div class="hero-badge-pill"><i class="fas fa-shield-check"></i> 100% Authentic Stock</div>
      <div class="hero-badge-pill"><i class="fas fa-clock"></i> Dispatch by 3:45pm</div>
    </div>
  </div>
  <div class="hero-stats">
    <div class="stat-item">
      <div class="stat-number">1,600+</div>
      <div class="stat-label">Authentic Products</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">50K+</div>
      <div class="stat-label">NZ Athletes Fuelled</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">4.9 ★</div>
      <div class="stat-label">Verified NZ Reviews</div>
    </div>
  </div>
</section>

