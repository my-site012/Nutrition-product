<header id="site-header">
  <div class="header-main-row">
    <div class="header-inner">
      <div class="header-left">
        <button class="mobile-menu-btn d-mobile-only" id="mobileMenuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
          <i class="fas fa-bars"></i>
        </button>

        <div class="header-logo">
          <a href="{{ routes.root_url }}" title="{{ shop.name }}">
            {%- if settings.logo -%}
              <img
                src="{{ settings.logo | image_url: width: 220 }}"
                alt="{{ shop.name }}"
                class="logo-img"
                loading="eager"
                width="180"
                height="48"
              >
            {%- else -%}
              <span class="logo-text">NSNZ<span class="logo-dot">.</span><span class="logo-sub">NUTRITION</span></span>
            {%- endif -%}
          </a>
        </div>
      </div>

      <div class="header-center">
        <form class="desktop-search" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <div class="search-input-wrap">
            <i class="fas fa-search search-input-icon"></i>
            <label class="sr-only" for="headerSearch">Search products...</label>
            <input
              type="text"
              id="headerSearch"
              name="q"
              placeholder="Search protein, creatine, pre-workout, brands..."
              autocomplete="off"
              value="{{ search.terms | escape }}"
            >
            <button type="submit" class="search-submit-btn" aria-label="Search">
              <span>Search</span>
              <i class="fas fa-arrow-right"></i>
            </button>
          </div>
          <div class="search-suggestions" id="searchSuggestions" aria-live="polite"></div>
        </form>
      </div>

      <div class="header-right">
        <div class="header-support d-desktop-only">
          <i class="fas fa-phone-volume"></i>
          <div class="support-text">
            <span class="support-sub">Need Expert Advice?</span>
            <span class="support-main">0800 000 676</span>
          </div>
        </div>

        <button class="header-icon d-mobile-only" id="mobileSearchBtn" title="Search" aria-label="Open search">
          <i class="fas fa-search"></i>
        </button>

        <a href="{{ routes.account_url }}" class="header-icon" title="Account" aria-label="Account">
          <i class="fas fa-user"></i>
        </a>

        <a href="#wishlist" class="header-icon wishlist-icon" id="wishlistToggle" title="Wishlist" aria-label="Wishlist">
          <i class="fas fa-heart"></i>
          <span class="wishlist-badge" id="wishlistBadge" style="display:none">0</span>
        </a>

        <button class="header-icon cart-icon" id="cartToggle" title="Cart" aria-label="Open cart" aria-expanded="false">
          <div class="cart-icon-wrap">
            <i class="fas fa-shopping-bag"></i>
            {%- if cart.item_count > 0 -%}
              <span class="cart-count" id="cartCount">{{ cart.item_count }}</span>
            {%- else -%}
              <span class="cart-count" id="cartCount" style="display:none">0</span>
            {%- endif -%}
          </div>
          <div class="cart-btn-label d-desktop-only">
            <span class="cart-lbl-text">Cart</span>
            <span class="cart-lbl-total" id="headerCartTotal">{{ cart.total_price | money }}</span>
          </div>
        </button>
      </div>
    </div>
  </div>

  {%- comment -%} Desktop Category Navigation Bar (SprintFit Style) {%- endcomment -%}
  <nav class="header-nav-bar d-desktop-only" aria-label="Primary navigation">
    <div class="nav-bar-inner">
      <div class="nav-item-category-dropdown">
        <button class="nav-category-btn" id="categoryDropdownBtn" aria-expanded="false">
          <i class="fas fa-bars"></i>
          <span>Shop Categories</span>
          <i class="fas fa-chevron-down caret-icon"></i>
        </button>
        <div class="category-dropdown-menu" id="categoryDropdownMenu">
          <a href="/collections/all/protein-powder" class="dropdown-link"><i class="fas fa-dumbbell"></i> Protein Powder</a>
          <a href="/collections/all/pre-workout" class="dropdown-link"><i class="fas fa-bolt"></i> Pre-Workout &amp; Pump</a>
          <a href="/collections/all/creatine" class="dropdown-link"><i class="fas fa-atom"></i> Creatine Monohydrate</a>
          <a href="/collections/all/energy-drink" class="dropdown-link"><i class="fas fa-fire"></i> Energy Drinks &amp; RTD</a>
          <a href="/collections/all/protein-bars" class="dropdown-link"><i class="fas fa-cookie-bite"></i> Protein Bars &amp; Snacks</a>
          <a href="/collections/all/weight-loss" class="dropdown-link"><i class="fas fa-flame"></i> Fat Burners &amp; Shred</a>
          <a href="/collections/all/bcaa" class="dropdown-link"><i class="fas fa-dna"></i> BCAAs &amp; EAAs</a>
          <a href="/collections/all/accessories" class="dropdown-link"><i class="fas fa-bottle-water"></i> Shakers &amp; Gym Gear</a>
          <a href="/collections/all" class="dropdown-link dropdown-all-link">Browse All 1,000+ Products <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>

      <ul class="desktop-nav-links">
        <li><a href="/collections/all/protein-powder">Protein Powder</a></li>
        <li><a href="/collections/all/pre-workout">Pre-Workout</a></li>
        <li><a href="/collections/all/creatine">Creatine</a></li>
        <li><a href="/collections/all/energy-drink">Energy Drinks</a></li>
        <li><a href="/collections/all/protein-bars">Protein Bars</a></li>
        <li><a href="/collections/all/weight-loss">Fat Burners</a></li>
        <li><a href="/collections/all/accessories">Shakers &amp; Gear</a></li>
        <li class="has-nav-sub">
          <a href="#goal-section">Shop By Goal <i class="fas fa-chevron-down"></i></a>
          <div class="nav-sub-menu">
            <a href="#goal-section" data-nav-goal="muscle-building">Lean Muscle Growth</a>
            <a href="#goal-section" data-nav-goal="weight-loss">Weight Loss &amp; Shred</a>
            <a href="#goal-section" data-nav-goal="energy">Energy &amp; Focus</a>
            <a href="#goal-section" data-nav-goal="recovery">Fast Muscle Recovery</a>
            <a href="#goal-section" data-nav-goal="gain-mass">Maximum Size &amp; Mass</a>
          </div>
        </li>
        <li><a href="/collections/all/best-seller" class="nav-badge-link">Top 50</a></li>
        <li><a href="/collections/all/best-seller" class="nav-pill-deal"><i class="fas fa-fire"></i> Specials</a></li>
      </ul>
    </div>
  </nav>

  <div class="mobile-search-bar" id="mobileSearchBar">
    <form action="{{ routes.search_url }}" method="get">
      <input type="hidden" name="type" value="product">
      <input type="text" name="q" placeholder="Search products, brands..." aria-label="Search">
      <button type="submit" aria-label="Search"><i class="fas fa-search"></i></button>
    </form>
    <button class="close-search" id="closeSearch" aria-label="Close search">
      <i class="fas fa-times"></i>
    </button>
  </div>
</header>

