          <li><a href="/collections/all/accessories">Shakers &amp; Accessories</a></li>
        </ul>
      </li>
      <li><a href="/collections/all/best-seller">Top 50 Supplements</a></li>
      <li class="has-children">
        <span class="nav-parent" role="button" tabindex="0" aria-expanded="false">
          Shop by Goal <i class="fas fa-plus"></i>
        </span>
        <ul class="sub-menu">
          <li><a href="#goal-section">Lean Muscle Building</a></li>
          <li><a href="#goal-section">Weight Loss &amp; Shred</a></li>
          <li><a href="#goal-section">Extreme Energy &amp; Focus</a></li>
          <li><a href="#goal-section">Muscle Recovery</a></li>
          <li><a href="#goal-section">Mass &amp; Size Gaining</a></li>
        </ul>
      </li>
      <li><a href="/collections/all/best-seller" class="highlight-red"><i class="fas fa-fire"></i> Special Offers &amp; Deals</a></li>
      <li><a href="/collections/all">Browse All Products</a></li>
    </ul>

    <div class="mobile-menu-contact">
      <div class="contact-pill">
        <i class="fas fa-phone-volume"></i>
        <div>
          <span>Need Help? Call Us</span>
          <strong>0800 000 676</strong>
        </div>
      </div>
      <div class="contact-pill">
        <i class="fas fa-truck-fast"></i>
        <div>
          <span>Same Day NZ Dispatch</span>
          <strong>Order by 3:45pm</strong>
        </div>
      </div>
    </div>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
