  <div class="mobile-menu-body">
    <ul class="mobile-nav">
      <li class="has-children">
        <span class="nav-parent" role="button" tabindex="0" aria-expanded="false">
          Sports Supplements <i class="fas fa-plus"></i>
        </span>
        <ul class="sub-menu">
          <li><a href="/collections/all">All Sports Supplements</a></li>
          <li><a href="/collections/all/protein-powder">Protein Powder</a></li>
          <li><a href="/collections/all/creatine">Creatine</a></li>
