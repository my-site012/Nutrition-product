<header id="site-header">
  <div class="header-inner">

    <div class="header-left">
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <i class="fas fa-bars"></i>
        <span class="menu-text">Shop Now</span>
      </button>
    </div>

    <div class="header-logo">
      <a href="{{ routes.root_url }}" title="{{ shop.name }}">
        {%- if settings.logo -%}
          <img
            src="{{ settings.logo | image_url: width: 200 }}"
            alt="{{ shop.name }}"
            class="logo-img"
            loading="eager"
            width="160"
            height="44"
          >
        {%- else -%}
          <span class="logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <div class="header-right">
      <form class="desktop-search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <label class="sr-only" for="headerSearch">Search</label>
        <input
          type="text"
          id="headerSearch"
          name="q"
          placeholder="Search products..."
          autocomplete="off"
          value="{{ search.terms | escape }}"
        >
        <button type="submit" aria-label="Search">
          <i class="fas fa-search"></i>
        </button>
        <div class="search-suggestions" id="searchSuggestions" aria-live="polite"></div>
      </form>

      <a href="{{ routes.account_url }}" class="header-icon" title="Account" aria-label="Account">
        <i class="fas fa-user"></i>
      </a>

      <button class="header-icon cart-icon" id="cartToggle" title="Cart" aria-label="Open cart" aria-expanded="false">
        <i class="fas fa-shopping-bag"></i>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count" id="cartCount">{{ cart.item_count }}</span>
        {%- else -%}
          <span class="cart-count" id="cartCount" style="display:none">0</span>
        {%- endif -%}
      </button>
    </div>
  </div>

  <div class="mobile-search-bar" id="mobileSearchBar">
    <form action="{{ routes.search_url }}" method="get">
      <input type="hidden" name="type" value="product">
      <input type="text" name="q" placeholder="Search products..." aria-label="Search">
      <button type="submit" aria-label="Search"><i class="fas fa-search"></i></button>
    </form>
    <button class="close-search" id="closeSearch" aria-label="Close search">
      <i class="fas fa-times"></i>
    </button>
  </div>
</header>

<div class="mobile-menu-overlay" id="menuOverlay"></div>
<nav class="mobile-menu" id="mobileMenu" aria-label="Mobile navigation" aria-hidden="true">
  <div class="mobile-menu-header">
    <span class="mobile-menu-title">Shop Now</span>
    <button class="close-menu" id="closeMenu" aria-label="Close menu">
      <i class="fas fa-times"></i>
    </button>
  </div>
  <div class="mobile-menu-body">
    <ul class="mobile-nav">
      <li class="has-children">
        <span class="nav-parent" role="button" tabindex="0" aria-expanded="false">
          Sports Supplements <i class="fas fa-plus"></i>
        </span>
        <ul class="sub-menu">
          <li><a href="/collections/all-sports-supplements">All Sports Supplements</a></li>
          <li><a href="/collections/protein-powder">Protein Powder</a></li>
          <li><a href="/collections/creatine">Creatine</a></li>
          <li><a href="/collections/pre-workout">Pre Workout</a></li>
          <li><a href="/collections/protein-bars">Protein Bars</a></li>
          <li><a href="/collections/weight-loss">Weight Loss</a></li>
          <li><a href="/collections/amino-acids">Amino Acids &amp; BCAAs</a></li>
          <li><a href="/collections/hydration-endurance">Hydration &amp; Endurance</a></li>
          <li><a href="/collections/combos">Combos</a></li>
          <li><a href="/collections/testosterone-booster">Testosterone Booster</a></li>
        </ul>
      </li>
      <li><a href="/collections/top-50">Top 50 Supplements</a></li>
      <li class="has-children">
        <span class="nav-parent" role="button" tabindex="0" aria-expanded="false">
          Natural Health <i class="fas fa-plus"></i>
        </span>
        <ul class="sub-menu">
          <li><a href="/collections/natural-health">All Natural Health</a></li>
          <li><a href="/collections/vitamins">Vitamins</a></li>
          <li><a href="/collections/super-greens">Super Greens</a></li>
          <li><a href="/collections/collagen">Collagen Supplements</a></li>
          <li><a href="/collections/gut-health">Gut Health</a></li>
          <li><a href="/collections/minerals">Minerals</a></li>
          <li><a href="/collections/sleep-support">Sleep Support</a></li>
        </ul>
      </li>
      <li class="has-children">
        <span class="nav-parent" role="button" tabindex="0" aria-expanded="false">
          Accessories <i class="fas fa-plus"></i>
        </span>
        <ul class="sub-menu">
          <li><a href="/collections/accessories">All Accessories</a></li>
          <li><a href="/collections/shakers">Shakers &amp; Water Bottles</a></li>
          <li><a href="/collections/workout-gear">Workout Gear</a></li>
          <li><a href="/collections/apparel">Apparel &amp; Clothing</a></li>
          <li><a href="/collections/blenders">Blenders</a></li>
        </ul>
      </li>
      <li class="has-children">
        <span class="nav-parent" role="button" tabindex="0" aria-expanded="false">
          Shop by Goal <i class="fas fa-plus"></i>
        </span>
        <ul class="sub-menu">
          <li><a href="/collections/weight-loss">Weight Loss</a></li>
          <li><a href="/collections/lean-muscle">Lean Muscle Building</a></li>
          <li><a href="/collections/gain-mass">Gain Mass</a></li>
          <li><a href="/collections/recovery">Recovery</a></li>
          <li><a href="/collections/energy-endurance">Energy &amp; Endurance</a></li>
        </ul>
      </li>
      <li><a href="/collections/specials" class="highlight-red">Special Offers</a></li>
      <li><a href="/collections/clearance" class="highlight-orange">Clearance</a></li>
      <li><a href="/collections/new-arrivals">New Arrivals</a></li>
      <li><a href="/collections/brands">Shop By Brand</a></li>
    </ul>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
