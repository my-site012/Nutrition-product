<div class="container" style="padding: 60px 20px; min-height: 60vh;">
  <h1 style="font-size: 32px; font-weight: 800; margin-bottom: 24px;">Search Results</h1>

  <form action="{{ routes.search_url }}" method="get" style="display: flex; gap: 12px; max-width: 600px; margin-bottom: 40px;">
    <input type="hidden" name="type" value="product">
    <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Search products..." style="flex: 1; padding: 12px 16px; background: #1a1a1a; border: 1px solid var(--border); border-radius: 4px; color: #fff; font-size: 14px;">
    <button type="submit" class="btn-primary" style="padding: 12px 24px;">Search</button>
  </form>

  {% if search.performed %}
    <p style="color: var(--text-muted); margin-bottom: 24px;">Found {{ search.results_count }} results for "{{ search.terms }}"</p>
    {% if search.results_count > 0 %}
      <div class="product-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', product: item %}
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p>No products found matching your search. Try another query.</p>
    {% endif %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
