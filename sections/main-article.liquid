<div class="container" style="padding: 60px 20px; max-width: 800px; min-height: 50vh;">
  <h1 style="font-size: 36px; font-weight: 800; margin-bottom: 16px;">{{ article.title }}</h1>
  <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 30px;">Published on {{ article.published_at | date: '%B %d, %Y' }} by {{ article.author }}</p>
  {% if article.image %}
    <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" width="800" height="400" style="width: 100%; height: auto; border-radius: var(--radius); margin-bottom: 30px;">
  {% endif %}
  <div class="article-content" style="color: var(--text-muted); line-height: 1.8; font-size: 16px;">
    {{ article.content }}
  </div>
</div>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
