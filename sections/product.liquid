{%- comment -%} Product Page Section {%- endcomment -%}

<div class="product-page">
  <div class="container">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}"><i class="fas fa-home"></i> Home</a>
      <i class="fas fa-chevron-right"></i>
      {%- if product.collections.size > 0 -%}
        {%- assign first_col = product.collections.first -%}
        <a href="{{ first_col.url }}">{{ first_col.title }}</a>
        <i class="fas fa-chevron-right"></i>
      {%- elsif product.tags.size > 0 -%}
        <a href="{{ routes.collections_url }}/all/{{ product.tags.first | handle }}">{{ product.tags.first }}</a>
        <i class="fas fa-chevron-right"></i>
      {%- endif -%}
      <span class="active-crumb">{{ product.title | truncate: 50 }}</span>
    </nav>

    <div class="product-layout">

      <div class="product-images">
        <div class="main-image-wrap">
          <img
            id="mainProductImg"
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="800"
            height="800"
            loading="eager"
          >
          {%- if product.compare_at_price > product.price -%}
            {%- assign disc_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
            <div class="product-save-badge"><i class="fas fa-fire"></i> SAVE {{ disc_pct }}%</div>
          {%- endif -%}
          <button class="card-wishlist" data-id="{{ product.id }}" aria-label="Add to wishlist" title="Save to Wishlist">
            <i class="fas fa-heart"></i>
          </button>
        </div>
        {%- if product.images.size > 1 -%}
          <div class="thumbnail-strip">
            {%- for image in product.images -%}
              <button
                type="button"
                class="thumb-btn {%- if forloop.first -%} active{%- endif -%}"
                data-src="{{ image | image_url: width: 800 }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img src="{{ image | image_url: width: 150 }}" alt="{{ image.alt | escape }}" loading="lazy" width="72" height="72">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="product-gallery-features">
          <div class="gallery-feature-item">
            <i class="fas fa-shield-halved"></i>
            <span>100% Genuine Guaranteed</span>
          </div>
          <div class="gallery-feature-item">
            <i class="fas fa-snowflake"></i>
            <span>Temperature-Controlled Storage</span>
          </div>
        </div>
      </div>

      <div class="product-info">
        {%- if product.vendor != blank -%}
          <div class="product-vendor-row">
            <span class="product-vendor-name">{{ product.vendor }}</span>
            <span class="product-official-badge"><i class="fas fa-circle-check"></i> Official NZ Retailer</span>
          </div>
        {%- endif -%}

        <h1 class="product-main-title">{{ product.title }}</h1>

        <div class="product-meta-row">
          <div class="product-stars">
            <span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="rating-score">4.9</span>
            <a href="#tab-reviews" class="rating-count" onclick="document.querySelector('[data-tab=reviews]').click();">(48 verified reviews)</a>
          </div>
          {%- if product.available -%}
            <span class="stock-badge in-stock" id="productStockBadge">In Stock</span>
          {%- else -%}
            <span class="stock-badge out-of-stock" id="productStockBadge">Sold Out</span>
          {%- endif -%}
        </div>

        <div class="product-price-wrap">
          <div class="price-main-group">
            <span class="product-price-main" id="productPrice">{{ product.price | money }}</span>
            <span class="product-price-compare" id="productComparePrice"{% unless product.compare_at_price > product.price %} style="display:none;"{% endunless %}>
              {%- if product.compare_at_price > product.price -%}{{ product.compare_at_price | money }}{%- endif -%}
            </span>
          </div>
          <span class="price-currency">NZD (incl. 15% GST)</span>
        </div>

        <div class="product-installments">
          <span class="inst-label">or 4 interest-free payments of</span>
          <strong class="inst-price" id="installmentAmount">{{ product.price | divided_by: 4 | money }}</strong>
          <span class="inst-provider">with</span>
          <span class="badge-afterpay">afterpay<i class="fas fa-arrows-split-up-and-left" style="font-size:7px;margin-left:2px"></i></span>
          <span class="inst-provider">or</span>
          <span class="badge-zip">zip</span>
        </div>

        <div class="product-dispatch-notice">
          <i class="fas fa-truck-fast"></i>
          <div>
            <strong>Same-Day Dispatch from Auckland:</strong>
            <span>Order before 3:45 PM NZST for same-day courier dispatch. Free shipping on orders over $60.</span>
          </div>
        </div>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="variant-group">
              <label class="variant-label">
                <span>Select {{ option.name }}:</span>
                <span class="variant-selected" id="sel-{{ option.position }}">{{ option.selected_value }}</span>
              </label>
              <div class="variant-options">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="variant-btn {%- if option.selected_value == value -%} active{%- endif -%}"
                    data-option="{{ option.position }}"
                    data-value="{{ value | escape }}"
                    aria-label="{{ option.name }}: {{ value }}"
                  >
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="atc-row">
          <div class="qty-wrap">
            <button type="button" class="qty-change" data-dir="-1" aria-label="Decrease quantity">&#8722;</button>
            <input type="number" id="productQty" value="1" min="1" max="99" aria-label="Quantity">
            <button type="button" class="qty-change" data-dir="1" aria-label="Increase quantity">&#43;</button>
          </div>
          <button
            type="button"
            id="addToCartBtn"
            class="btn-primary atc-btn"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            {%- unless product.available -%} disabled{%- endunless -%}
          >
            {%- if product.available -%}
              <i class="fas fa-shopping-bag"></i> Add to Cart
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>
        </div>

        <button
          type="button"
          id="buyNowBtn"
          class="btn-outline buy-now-btn"
          {%- unless product.available -%} style="display:none;"{%- endunless -%}
        >
          <i class="fas fa-bolt"></i> Buy Now with 1-Click
        </button>

        <div class="product-trust-grid">
          <div class="product-trust-item">
            <i class="fas fa-truck-fast"></i>
            <div>
              <strong>Fast NZ Delivery</strong>
              <span>1-2 Day CourierPost</span>
            </div>
          </div>
          <div class="product-trust-item">
            <i class="fas fa-shield-halved"></i>
            <div>
              <strong>100% Authentic</strong>
              <span>Direct NZ Distributor</span>
            </div>
          </div>
          <div class="product-trust-item">
            <i class="fas fa-rotate-left"></i>
            <div>
              <strong>Hassle-Free Returns</strong>
              <span>30-Day Guarantee</span>
            </div>
          </div>
        </div>

        {%- if product.tags.size > 0 -%}
          <div class="product-tags">
            <span class="product-tags-label"><i class="fas fa-tags"></i> Categories:</span>
            {%- for tag in product.tags -%}
              <a href="{{ routes.collections_url }}/all/{{ tag | handle }}" class="product-tag">{{ tag }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="product-tabs-section">
      <div class="product-tabs" role="tablist">
        <button type="button" class="product-tab active" role="tab" aria-selected="true" data-tab="description">
          <i class="fas fa-file-lines"></i> Description
        </button>
        <button type="button" class="product-tab" role="tab" aria-selected="false" data-tab="nutrition">
          <i class="fas fa-flask"></i> Nutritional Info
        </button>
        <button type="button" class="product-tab" role="tab" aria-selected="false" data-tab="usage">
          <i class="fas fa-circle-info"></i> How to Use
        </button>
        <button type="button" class="product-tab" role="tab" aria-selected="false" data-tab="reviews">
          <i class="fas fa-star"></i> Reviews (48)
        </button>
      </div>

      <div class="tab-panel active" id="tab-description" role="tabpanel">
        <div class="tab-content product-description-body">
          {%- if product.description != blank -%}
            {{ product.description }}
          {%- else -%}
            <div class="description-highlights">
              <h3>Feel the Difference with Authentic Formula</h3>
              <p>Formulated to deliver clean energy, dialed-in focus, and industry-leading flavor collaboration without the crash or jitters. Crafted with premium active ingredients including natural caffeine, Carnipure&reg; L-Carnitine, and Alpha-GPC for sustained physical and cognitive performance.</p>
              <ul class="feature-bullets">
                <li><i class="fas fa-check"></i> <strong>200mg Natural Caffeine</strong> derived from coffee beans for a smooth, sustained boost.</li>
                <li><i class="fas fa-check"></i> <strong>Carnipure&reg; L-Carnitine (1000mg)</strong> to support cellular energy production and fat metabolism.</li>
                <li><i class="fas fa-check"></i> <strong>NeuroFactor&reg; &amp; Alpha-GPC</strong> for razor-sharp mental focus and reaction speed.</li>
                <li><i class="fas fa-check"></i> <strong>Zero Sugar, Zero Artificial Dyes</strong> &ndash; only 5 calories per serving.</li>
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="tab-panel" id="tab-nutrition" role="tabpanel">
        <div class="tab-content">
          {%- assign p_lower = product.title | append: ' ' | append: product.tags | downcase -%}
          {%- if p_lower contains 'protein' -%}
            <h3>Nutritional Panel (Per 30g Serving)</h3>
            <table class="nutrition-table">
              <thead>
                <tr>
                  <th>Nutrient</th>
                  <th>Per 30g Serve</th>
                  <th>Per 100g</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Energy</td><td>504 kJ (120 kcal)</td><td>1680 kJ (400 kcal)</td></tr>
                <tr class="highlight-row"><td>Protein</td><td>24.2 g</td><td>80.6 g</td></tr>
                <tr><td>Fat, Total</td><td>1.4 g</td><td>4.6 g</td></tr>
                <tr><td>&ndash; Saturated Fat</td><td>0.8 g</td><td>2.6 g</td></tr>
                <tr><td>Carbohydrate</td><td>2.1 g</td><td>7.0 g</td></tr>
                <tr><td>&ndash; Sugars</td><td>1.1 g</td><td>3.6 g</td></tr>
                <tr><td>Dietary Fibre</td><td>0.5 g</td><td>1.6 g</td></tr>
                <tr><td>Sodium</td><td>145 mg</td><td>483 mg</td></tr>
                <tr class="highlight-row"><td>BCAA Matrix (Leucine, Isoleucine, Valine)</td><td>5.5 g</td><td>18.3 g</td></tr>
              </tbody>
            </table>
          {%- else -%}
            <h3>Nutritional Facts &amp; Active Matrix (Per 500ml Can / Serving)</h3>
            <table class="nutrition-table">
              <thead>
                <tr>
                  <th>Component</th>
                  <th>Amount Per Serve</th>
                  <th>% Daily Value*</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Energy (Calories)</td><td>21 kJ (5 kcal)</td><td>&lt;1%</td></tr>
                <tr><td>Total Carbohydrate</td><td>1.0 g</td><td>&lt;1%</td></tr>
                <tr><td>&ndash; Sugars</td><td>0.0 g</td><td>0%</td></tr>
                <tr><td>Sodium</td><td>35 mg</td><td>2%</td></tr>
                <tr class="highlight-row"><td>Natural Caffeine (from Coffee Bean)</td><td>200 mg</td><td>**</td></tr>
                <tr class="highlight-row"><td>Carnipure&reg; L-Carnitine L-Tartrate</td><td>1,000 mg</td><td>**</td></tr>
                <tr><td>Taurine</td><td>1,000 mg</td><td>**</td></tr>
                <tr><td>Alpha-GPC (Alpha-Glyceryl Phosphoryl Choline 50%)</td><td>150 mg</td><td>**</td></tr>
                <tr><td>NeuroFactor&reg; Whole Coffee Fruit Extract</td><td>100 mg</td><td>**</td></tr>
                <tr><td>AstraGin&reg; (Astragalus &amp; Panax Notoginseng)</td><td>25 mg</td><td>**</td></tr>
                <tr><td>Vitamin C (Ascorbic Acid)</td><td>90 mg</td><td>100%</td></tr>
                <tr><td>Niacin (Vitamin B3)</td><td>16 mg</td><td>100%</td></tr>
                <tr><td>Vitamin B6 (Pyridoxine HCl)</td><td>1.7 mg</td><td>100%</td></tr>
                <tr><td>Vitamin B12 (Methylcobalamin)</td><td>2.4 mcg</td><td>100%</td></tr>
              </tbody>
            </table>
            <p style="font-size:12px;color:var(--text-muted);margin-top:10px;">* Percentage daily intakes are based on an average adult diet of 8,700 kJ. ** Daily Value not established. Zero artificial colors or dyes.</p>
          {%- endif -%}
        </div>
      </div>

      <div class="tab-panel" id="tab-usage" role="tabpanel">
        <div class="tab-content">
          {%- assign p_lower = product.title | append: ' ' | append: product.tags | downcase -%}
          {%- if p_lower contains 'protein' -%}
            <h3>Recommended Directions</h3>
            <ol class="usage-steps">
              <li>Add 1 rounded scoop (approx. 30g) to 250ml–300ml of cold water or your choice of milk in a shaker bottle.</li>
              <li>Shake firmly for 20–30 seconds until completely dissolved.</li>
              <li>Consume immediately after your workout to assist muscle protein synthesis, or between meals as a protein-rich snack.</li>
              <li>Adjust liquid volume to customize your preferred thickness and flavor intensity.</li>
            </ol>
          {%- elsif p_lower contains 'pre-workout' -%}
            <h3>Recommended Directions</h3>
            <ol class="usage-steps">
              <li>Mix 1 scoop with 250ml–300ml of cold water 20–30 minutes before your workout or high-intensity exercise.</li>
              <li>Beginners: Start with 1/2 scoop to assess individual tolerance to caffeine and active ingredients.</li>
              <li>Stay well hydrated by drinking plenty of water during your workout session.</li>
              <li>Avoid consuming within 4–5 hours of sleep to prevent sleep disturbances.</li>
            </ol>
          {%- else -%}
            <h3>Recommended Directions &amp; Advice</h3>
            <ol class="usage-steps">
              <li>Serve chilled from the fridge for optimal crisp taste and refreshment.</li>
              <li>Consume 1 can 15&ndash;30 minutes before physical training, study, gaming, or whenever you need dialed-in focus.</li>
              <li>Do not exceed more than 1 can within a 24-hour period.</li>
              <li>Keep out of reach of children. Not recommended for children, pregnant or breastfeeding women, or individuals sensitive to caffeine.</li>
            </ol>
          {%- endif -%}
        </div>
      </div>

      <div class="tab-panel" id="tab-reviews" role="tabpanel">
        <div class="tab-content">
          <div class="reviews-summary-bar">
            <div class="summary-left">
              <div class="big-rating">4.9</div>
              <div class="rating-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <div class="rating-total">Based on 48 verified NZ reviews</div>
            </div>
            <div class="summary-right">
              <div class="rating-bar-row">
                <span>5 Star</span>
                <div class="bar-track"><div class="bar-fill" style="width:92%"></div></div>
                <span>92%</span>
              </div>
              <div class="rating-bar-row">
                <span>4 Star</span>
                <div class="bar-track"><div class="bar-fill" style="width:8%"></div></div>
                <span>8%</span>
              </div>
              <div class="rating-bar-row">
                <span>3 Star</span>
                <div class="bar-track"><div class="bar-fill" style="width:0%"></div></div>
                <span>0%</span>
              </div>
            </div>
          </div>

          <div class="reviews-grid">
            <div class="review-card">
              <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <span class="review-flavor"><i class="fas fa-check"></i> Verified Purchase &bull; Swedish Fish</span>
              <p class="review-text">&ldquo;Hands down the best energy drink on the market in NZ. The flavor is 100% authentic, super crisp carbonation, and zero artificial chemical aftertaste. Gives clean focus without any jitters or afternoon crash.&rdquo;</p>
              <div class="review-author">
                <div class="review-avatar">LM</div>
                <div>
                  <div class="review-name">Liam M. <span class="review-verified"><i class="fas fa-certificate"></i> Verified Buyer</span></div>
                  <div class="review-date">Auckland &bull; 2 days ago</div>
                </div>
              </div>
            </div>

            <div class="review-card">
              <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <span class="review-flavor"><i class="fas fa-check"></i> Verified Purchase &bull; Sour Watermelon</span>
              <p class="review-text">&ldquo;Super fast overnight courier dispatch to Christchurch! Cans arrived perfectly packed with no dents. The 200mg natural caffeine paired with Alpha-GPC is a game changer for morning gym sessions.&rdquo;</p>
              <div class="review-author">
                <div class="review-avatar">JK</div>
                <div>
                  <div class="review-name">Jessica K. <span class="review-verified"><i class="fas fa-certificate"></i> Verified Buyer</span></div>
                  <div class="review-date">Christchurch &bull; 1 week ago</div>
                </div>
              </div>
            </div>

            <div class="review-card">
              <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <span class="review-flavor"><i class="fas fa-check"></i> Verified Purchase &bull; Blue Raspberry</span>
              <p class="review-text">&ldquo;Legit store, genuine NZ import. I used to order these overseas for double the price, so glad NSNZ stocks full cases. 10/10 flavor and unbeatable customer service.&rdquo;</p>
              <div class="review-author">
                <div class="review-avatar">TB</div>
                <div>
                  <div class="review-name">Trent B. <span class="review-verified"><i class="fas fa-certificate"></i> Verified Buyer</span></div>
                  <div class="review-date">Mount Maunganui &bull; 2 weeks ago</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {%- assign first_tag = product.tags.first -%}
    {%- if first_tag != blank -%}
      {%- assign tag_handle = first_tag | handle -%}
      {%- assign related_col = collections[tag_handle] -%}
      {%- if related_col != blank and related_col.products.size > 1 -%}
        <div class="related-products">
          <div class="section-title" style="text-align:left;">
            <span class="section-subtitle">You May Also Like</span>
            <h2>Related <span>Products</span></h2>
          </div>
          <div class="product-grid">
            {%- for rp in related_col.products limit: 4 -%}
              {%- unless rp.id == product.id -%}
                {%- render 'product-card', product: rp -%}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

<script>
  window.__variantData = {{ product.variants | json }};

  document.addEventListener('DOMContentLoaded', function() {
    var mainImg = document.getElementById('mainProductImg');

    document.querySelectorAll('.thumb-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.thumb-btn').forEach(function(b) { b.classList.remove('active'); });
        this.classList.add('active');
        if (mainImg) mainImg.src = this.dataset.src;
      });
    });

    document.querySelectorAll('.qty-change').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var input = document.getElementById('productQty');
        var val = parseInt(input.value) + parseInt(this.dataset.dir);
        if (val >= 1 && val <= 99) input.value = val;
      });
    });

    function formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    function updateSelectedVariant() {
      if (!window.__variantData || !window.__variantData.length) return;
      var selectedOptions = {};
      document.querySelectorAll('.variant-btn.active').forEach(function(btn) {
        selectedOptions['option' + btn.dataset.option] = btn.dataset.value;
      });

      var matchedVariant = window.__variantData.find(function(v) {
        var match = true;
        if (selectedOptions.option1 && v.option1 !== selectedOptions.option1) match = false;
        if (selectedOptions.option2 && v.option2 !== selectedOptions.option2) match = false;
        if (selectedOptions.option3 && v.option3 !== selectedOptions.option3) match = false;
        return match;
      });

      if (!matchedVariant && window.__variantData.length > 0) {
        matchedVariant = window.__variantData[0];
      }

      if (matchedVariant) {
        var priceEl = document.getElementById('productPrice');
        if (priceEl) priceEl.textContent = formatMoney(matchedVariant.price);

        var instEl = document.getElementById('installmentAmount');
        if (instEl) instEl.textContent = formatMoney(Math.round(matchedVariant.price / 4));

        var compEl = document.getElementById('productComparePrice');
        if (compEl) {
          if (matchedVariant.compare_at_price && matchedVariant.compare_at_price > matchedVariant.price) {
            compEl.textContent = formatMoney(matchedVariant.compare_at_price);
            compEl.style.display = '';
          } else {
            compEl.style.display = 'none';
          }
        }

        var stockBadge = document.getElementById('productStockBadge');
        var atc = document.getElementById('addToCartBtn');
        var buy = document.getElementById('buyNowBtn');

        if (atc) atc.dataset.variantId = matchedVariant.id;

        if (matchedVariant.available) {
          if (stockBadge) {
            stockBadge.className = 'stock-badge in-stock';
            stockBadge.textContent = 'In Stock';
          }
          if (atc) {
            atc.disabled = false;
            atc.innerHTML = '<i class="fas fa-shopping-bag"></i> Add to Cart';
          }
          if (buy) buy.style.display = '';
        } else {
          if (stockBadge) {
            stockBadge.className = 'stock-badge out-of-stock';
            stockBadge.textContent = 'Out of Stock';
          }
          if (atc) {
            atc.disabled = true;
            atc.innerHTML = 'Sold Out';
          }
          if (buy) buy.style.display = 'none';
        }

        if (matchedVariant.featured_image && matchedVariant.featured_image.src) {
          var mainImg = document.getElementById('mainProductImg');
          if (mainImg) mainImg.src = matchedVariant.featured_image.src;
          document.querySelectorAll('.thumb-btn').forEach(function(t) {
            if (t.dataset.src && t.dataset.src.indexOf(matchedVariant.featured_image.src) !== -1) {
              document.querySelectorAll('.thumb-btn').forEach(function(b) { b.classList.remove('active'); });
              t.classList.add('active');
            }
          });
        }
      }
    }

    document.querySelectorAll('.variant-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var pos = this.dataset.option;
        document.querySelectorAll('.variant-btn[data-option="' + pos + '"]').forEach(function(b) { b.classList.remove('active'); });
        this.classList.add('active');
        var selEl = document.getElementById('sel-' + pos);
        if (selEl) selEl.textContent = this.dataset.value;
        updateSelectedVariant();
      });
    });

    document.querySelectorAll('.product-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.product-tab').forEach(function(t) {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
        this.classList.add('active');
        this.setAttribute('aria-selected', 'true');
        var panel = document.getElementById('tab-' + this.dataset.tab);
        if (panel) panel.classList.add('active');
      });
    });

    var atcBtn = document.getElementById('addToCartBtn');
    if (atcBtn) {
      atcBtn.addEventListener('click', function() {
        var variantId = this.dataset.variantId;
        var qty = parseInt(document.getElementById('productQty').value) || 1;
        if (!variantId) return;
        var self = this;
        self.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
        self.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: parseInt(variantId), quantity: qty })
        })
        .then(function(r) { return r.json(); })
        .then(function() {
          self.innerHTML = '<i class="fas fa-check"></i> Added!';
          self.style.background = '#22c55e';
          return fetch('/cart.js');
        })
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          var countEl = document.getElementById('cartCount');
          if (countEl) { countEl.textContent = cart.item_count; countEl.style.display = ''; }
          if (window.showToast) showToast('Added to cart!');
          setTimeout(function() {
            self.innerHTML = '<i class="fas fa-shopping-bag"></i> Add to Cart';
            self.style.background = '';
            self.disabled = false;
          }, 2000);
        })
        .catch(function() {
          self.innerHTML = '<i class="fas fa-shopping-bag"></i> Add to Cart';
          self.disabled = false;
        });
      });
    }

    var buyBtn = document.getElementById('buyNowBtn');
    if (buyBtn) {
      buyBtn.addEventListener('click', function() {
        var atc = document.getElementById('addToCartBtn');
        var variantId = atc ? atc.dataset.variantId : null;
        var qty = parseInt(document.getElementById('productQty').value) || 1;
        if (!variantId) return;
        var self = this;
        self.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
        self.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: parseInt(variantId), quantity: qty })
        })
        .then(function() {
          window.location.href = '/checkout';
        })
        .catch(function() {
          window.location.href = '/cart';
        });
      });
    }
  });
</script>

